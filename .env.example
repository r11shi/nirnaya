# Database
DATABASE_URL=sqlite+aiosqlite:///./nirnaya.db
# For Postgres: DATABASE_URL=postgresql+asyncpg://nirnaya:nirnaya@localhost:5432/nirnaya

# LLM Providers (all optional - system works without them)
GEMINI_API_KEY=
GROQ_API_KEY=

# LLM Config
DEFAULT_LLM_PROVIDER=gemini
# Options: gemini, groq, local, mock

# Server
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Security
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3000"]

# Uploads
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
